@model IEnumerable<PolleriaLovely.ViewModels.GastoListadoViewModel>
@using PolleriaLovely.Models
@{ ViewData["Title"] = "Gastos"; }
<div class="page-heading d-flex justify-content-between align-items-center mb-4"><div><h1>Gastos</h1><p class="text-muted mb-0">Registra y consulta los gastos del negocio.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo gasto</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="form-card mb-4"><form asp-action="Index" method="get"><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label">Desde</label><input type="date" name="fechaInicio" value="@ViewBag.FechaInicio" class="form-control" /></div><div class="col-md-4"><label class="form-label">Hasta</label><input type="date" name="fechaFinal" value="@ViewBag.FechaFinal" class="form-control" /></div><div class="col-md-4"><button type="submit" class="btn btn-outline-primary">Filtrar</button><a asp-action="Index" class="btn btn-light ms-2">Limpiar</a></div></div></form></div>
<div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Fecha</th><th>Descripción</th><th>Categoría</th><th>Método</th><th>Monto</th><th>Registrado por</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var item in Model)
{
    var categoria = item.Categoria switch { CategoriaGasto.Servicios => "Servicios", CategoriaGasto.Alquiler => "Alquiler", CategoriaGasto.Personal => "Personal", CategoriaGasto.Compras => "Compras", CategoriaGasto.Mantenimiento => "Mantenimiento", _ => "Otros" };
    var metodo = item.MetodoPago == MetodoPago.YapePlin ? "Yape/Plin" : item.MetodoPago.ToString();
    <tr class="@(item.Anulado ? "opacity-50" : "")"><td>@item.Fecha.ToString("dd/MM/yyyy")</td><td class="fw-semibold">@item.Descripcion</td><td>@categoria</td><td>@metodo</td><td>S/ @item.Monto.ToString("N2")</td><td>@item.Usuario</td><td>@(item.Anulado ? "Anulado" : "Activo")</td><td class="text-end">@if (!item.Anulado) { <a asp-action="Edit" asp-route-id="@item.IdGasto" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="Anular" asp-route-id="@item.IdGasto" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Anular este gasto?')">Anular</button></form> }</td></tr>
}
@if (!Model.Any()) { <tr><td colspan="8" class="text-center py-5 text-muted">Aún no hay gastos registrados.</td></tr> }
</tbody></table></div></div>
