@model IEnumerable<PolleriaLovely.Models.Usuario>
@{ ViewData["Title"] = "Usuarios"; }
<div class="page-heading d-flex justify-content-between align-items-center mb-4"><div><h1>Usuarios</h1><p class="text-muted mb-0">Gestiona los usuarios, sus roles y su acceso al sistema.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo usuario</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
@{
    var idPropio = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var adminsActivos = Model.Count(u => u.Estado && u.Rol != null && u.Rol.NombreRol == "Administrador");
}
<div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Usuario</th><th>Nombre y apellido</th><th>Correo</th><th>Teléfono</th><th>Rol</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var item in Model)
{
    var esPropio = item.IdUsuario.ToString() == idPropio;
    var esUltimoAdmin = item.Estado && item.Rol != null && item.Rol.NombreRol == "Administrador" && adminsActivos == 1;
    var puedeToggle = !esPropio && !esUltimoAdmin;
    var aviso = item.Estado
        ? $"¿Desactivar al usuario «{item.NombreUsuario}»? No podrá iniciar sesión."
        : $"¿Activar al usuario «{item.NombreUsuario}»?";
    <tr>
        <td class="fw-semibold">@item.NombreUsuario</td>
        <td>@item.Nombre @item.Apellido</td>
        <td>@item.Correo</td>
        <td>@(string.IsNullOrWhiteSpace(item.Telefono) ? "—" : item.Telefono)</td>
        <td>@(item.Rol?.NombreRol ?? "Sin rol")</td>
        <td><span class="status-badge @(item.Estado ? "status-active" : "status-inactive")">@(item.Estado ? "Activo" : "Inactivo")</span></td>
        <td class="text-end">
            <a asp-action="Edit" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-primary">Editar</a>
            @if (puedeToggle)
            {
                <form asp-action="CambiarEstado" asp-route-id="@item.IdUsuario" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-@(item.Estado ? "warning" : "success")" onclick="return confirm('@aviso')">@((item.Estado) ? "Desactivar" : "Activar")</button></form>
            }
            <a asp-action="Delete" asp-route-id="@item.IdUsuario" class="btn btn-sm btn-outline-danger">Eliminar</a>
        </td>
    </tr>
}
@if (!Model.Any()) { <tr><td colspan="7" class="text-center py-5 text-muted">Aún no hay usuarios registrados.</td></tr> }</tbody></table></div></div>
