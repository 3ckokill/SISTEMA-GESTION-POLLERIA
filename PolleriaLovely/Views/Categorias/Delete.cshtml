@model PolleriaLovely.Models.Categoria
@{ ViewData["Title"] = "Eliminar categoría"; }

<div class="form-card">
    <p class="dashboard-eyebrow mb-2">CATÁLOGO</p>
    <h1>Eliminar categoría</h1>
    <div class="alert alert-warning mt-4">¿Estás seguro de que deseas eliminar esta categoría?</div>
    <dl class="row mb-4">
        <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.NombreCategoria</dd>
        <dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</dd>
        <dt class="col-sm-4">Productos asociados</dt><dd class="col-sm-8">@(Model.Productos?.Count ?? 0)</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdCategoria" />
        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
        <a asp-action="Index" class="btn btn-light">Cancelar</a>
    </form>
</div>
