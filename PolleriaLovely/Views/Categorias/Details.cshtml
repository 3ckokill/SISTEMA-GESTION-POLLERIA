@model PolleriaLovely.Models.Categoria
@{ ViewData["Title"] = "Detalle de categoría"; }

<div class="form-card">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <p class="dashboard-eyebrow mb-2">CATÁLOGO</p>
            <h1>Detalle de categoría</h1>
        </div>
        <span class="status-badge @(Model.Estado ? "status-active" : "status-inactive")">@(Model.Estado ? "Activa" : "Inactiva")</span>
    </div>
    <dl class="row mb-4">
        <dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.NombreCategoria</dd>
        <dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</dd>
        <dt class="col-sm-4">Productos asociados</dt><dd class="col-sm-8">@(Model.Productos?.Count ?? 0)</dd>
    </dl>
    <a asp-action="Index" class="btn btn-light">Volver a categorías</a>
    <a asp-action="Edit" asp-route-id="@Model.IdCategoria" class="btn btn-primary">Editar categoría</a>
</div>
