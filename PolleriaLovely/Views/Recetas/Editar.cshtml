@model PolleriaLovely.ViewModels.RecetaProductoViewModel
@{ ViewData["Title"] = "Receta del producto"; }
<div class="page-heading mb-4"><h1>Receta: @Model.NombreProducto</h1><p class="text-muted mb-0">Define los insumos consumidos por cada unidad vendida.</p></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="form-card mb-4">
    <h2 class="h5">Agregar insumo</h2>
    <p class="text-muted">La cantidad corresponde a una unidad del producto. Ejemplo: 0.25 pollo o 200 gramos de papa.</p>
    <form asp-action="Agregar" method="post">
        <input type="hidden" name="IdProducto" value="@Model.IdProducto" />
        <div class="row g-3 align-items-end">
            <div class="col-md-6">
                <label class="form-label" for="IdInsumo">Insumo</label>
                <select class="form-select" id="IdInsumo" name="IdInsumo" required>
                    <option value="">Selecciona un insumo</option>
                    @foreach (var insumo in Model.InsumosDisponibles) { <option value="@insumo.Value">@insumo.Text</option> }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label" for="Cantidad">Cantidad por unidad</label>
                <input class="form-control" type="number" inputmode="decimal" id="Cantidad" name="Cantidad" min="0.0001" max="1000000" step="0.0001" placeholder="Ej. 0.25" required />
            </div>
            <div class="col-md-3"><button type="submit" class="btn btn-success">Agregar a la receta</button></div>
        </div>
    </form>
</div>
<div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Insumo</th><th>Cantidad por unidad</th><th class="text-end">Acción</th></tr></thead><tbody>
@foreach (var linea in Model.Lineas)
{
    <tr><td class="fw-semibold">@linea.NombreInsumo</td><td>@linea.Cantidad.ToString("N4") @linea.UnidadMedida</td><td class="text-end"><form asp-action="Eliminar" method="post" class="d-inline"><input type="hidden" name="id" value="@linea.IdProductoInsumo" /><input type="hidden" name="idProducto" value="@Model.IdProducto" /><button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Retirar este insumo de la receta?');">Retirar</button></form></td></tr>
}
@if (!Model.Lineas.Any()) { <tr><td colspan="3" class="text-center py-5 text-muted">Este producto todavía no tiene insumos configurados.</td></tr> }
</tbody></table></div></div>
<div class="mt-4"><a asp-controller="Productos" asp-action="Index" class="btn btn-light">Volver a productos</a></div>
