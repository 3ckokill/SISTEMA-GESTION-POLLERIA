@model IEnumerable<PolleriaLovely.ViewModels.MesaListadoViewModel>
@{ ViewData["Title"] = "Mesas"; }
<div class="page-heading d-flex justify-content-between align-items-center mb-4"><div><h1>Mesas</h1><p class="text-muted mb-0">Administra las mesas disponibles para registrar pedidos.</p></div><a asp-action="Create" class="btn btn-primary">Nueva mesa</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Número</th><th>Estado administrativo</th><th>Disponibilidad</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var item in Model)
{
    <tr><td class="fw-semibold">Mesa @item.Numero</td><td><span class="status-badge @(item.Estado ? "status-active" : "status-inactive")">@(item.Estado ? "Activa" : "Inactiva")</span></td><td>@(item.Ocupada ? "Ocupada por un pedido en curso" : "Disponible")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.IdMesa" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="CambiarEstado" asp-route-id="@item.IdMesa" method="post" class="d-inline"><button type="submit" class="btn btn-sm btn-outline-@(item.Estado ? "warning" : "success")" onclick="return confirm('@(item.Estado ? "¿Desactivar esta mesa?" : "¿Activar esta mesa?")')">@(item.Estado ? "Desactivar" : "Activar")</button></form></td></tr>
}
@if (!Model.Any()) { <tr><td colspan="4" class="text-center py-5 text-muted">Aún no hay mesas registradas.</td></tr> }
</tbody></table></div></div>
