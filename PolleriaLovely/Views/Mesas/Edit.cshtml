@model PolleriaLovely.ViewModels.MesaEdicionViewModel
@{ ViewData["Title"] = "Editar mesa"; }
<div class="form-card"><h1>Editar mesa</h1><p class="text-muted">Actualiza el número o el estado administrativo de la mesa.</p><form asp-action="Edit" method="post"><input asp-for="IdMesa" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="Numero" class="form-label">Número de mesa</label><input asp-for="Numero" class="form-control" min="1" max="1000" /><span asp-validation-for="Numero" class="text-danger"></span></div><div class="form-check form-switch mb-4"><input asp-for="Estado" class="form-check-input" /><label asp-for="Estado" class="form-check-label">Mesa activa</label><span asp-validation-for="Estado" class="text-danger d-block"></span></div><a asp-action="Index" class="btn btn-light">Cancelar</a><button type="submit" class="btn btn-primary">Guardar cambios</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
