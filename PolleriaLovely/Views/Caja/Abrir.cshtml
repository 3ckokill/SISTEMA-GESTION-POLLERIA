@model PolleriaLovely.ViewModels.CajaAperturaViewModel
@{
    ViewData["Title"] = "Abrir caja";
}
<div class="form-card">
    <h1>Abrir caja</h1>
    <p class="text-muted">Ingresa el efectivo inicial disponible para este turno.</p>
    <form asp-action="Abrir" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3"><label asp-for="MontoInicial" class="form-label">Monto inicial (S/)</label><input
            asp-for="MontoInicial" class="form-control" step="0.01" min="0" /><span
            asp-validation-for="MontoInicial" class="text-danger"></span></div><a asp-action="Index"
                                                                                  class="btn btn-light">Cancelar</a><button type="submit" class="btn btn-primary">Abrir caja</button>
        </form>
    </div>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }