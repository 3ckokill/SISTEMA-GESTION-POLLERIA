@model PolleriaLovely.ViewModels.CajaCierreViewModel
@{ ViewData["Title"] = "Cerrar caja"; }
<div class="form-card"><h1>Cerrar caja</h1><p class="text-muted">Verifica el efectivo físico y registra el monto contado.</p><div class="mb-3"><div>Monto inicial: <strong>S/ @Model.MontoInicial.ToString("N2")</strong></div><div>Ventas en efectivo: <strong>S/ @Model.TotalEfectivo.ToString("N2")</strong></div><div>Efectivo esperado: <strong>S/ @Model.EfectivoEsperado.ToString("N2")</strong></div></div><form asp-action="Cerrar" method="post"><input asp-for="IdCaja" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="MontoContado" class="form-label">Efectivo contado (S/)</label><input asp-for="MontoContado" class="form-control" step="0.01" min="0" /><span asp-validation-for="MontoContado" class="text-danger"></span></div><a asp-action="Index" class="btn btn-light">Cancelar</a><button type="submit" class="btn btn-warning">Cerrar caja</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
