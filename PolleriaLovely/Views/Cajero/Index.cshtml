@{
    ViewData["Title"] = "Panel del cajero";
}

<div class="container py-4">
    <h1>Panel del cajero</h1>
    <p>Bienvenido al módulo de caja de PolleriaLovely.</p>
    <div class="alert alert-info">
        Gestiona ventas y cobra pedidos. Cuando un pedido esté en «Cuenta solicitada», revisa su precuenta antes de confirmar el cobro.
    </div>
    <a asp-controller="Ventas" asp-action="Create" class="btn btn-primary">Registrar nueva venta</a>
    <a asp-controller="Pedidos" asp-action="Index" class="btn btn-success">Ver pedidos y precuentas</a>
</div>