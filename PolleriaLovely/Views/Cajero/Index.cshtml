@{
    ViewData["Title"] = "Panel del cajero";
}

<div class="role-dashboard py-2">
    <section class="role-hero">
        <div>
            <p class="dashboard-eyebrow">OPERACIÓN DE CAJA</p>
            <h1>Panel del Cajero</h1>
            <p>Gestiona ventas, precuentas y el cierre diario de caja.</p>
        </div>
        <div class="role-hero-mark role-hero-mark-gold" aria-hidden="true">C</div>
    </section>

    <div class="role-actions role-actions-three">
        <div class="role-action-card">
            <span class="dashboard-card-icon icon-red">S/</span>
            <h2>Nueva venta</h2>
            <p>Registra una venta con el método de pago correspondiente.</p>
            <a asp-controller="Ventas" asp-action="Create" class="btn btn-primary">Registrar nueva venta</a>
        </div>
        <div class="role-action-card">
            <span class="dashboard-card-icon icon-gold">▤</span>
            <h2>Pedidos y precuentas</h2>
            <p>Revisa pedidos y confirma los cobros solicitados.</p>
            <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-primary">Ver pedidos</a>
        </div>
        <div class="role-action-card role-action-card-muted">
            <span class="dashboard-card-icon icon-navy">▥</span>
            <h2>Caja</h2>
            <p>Consulta el estado de tu caja y realiza el cierre diario.</p>
            <a asp-controller="Caja" asp-action="Index" class="btn btn-outline-primary">Abrir o cerrar caja</a>
        </div>
    </div>
</div>