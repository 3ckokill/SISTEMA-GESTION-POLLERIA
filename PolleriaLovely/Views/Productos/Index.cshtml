@model IEnumerable<PolleriaLovely.Models.Producto>
@{ ViewData["Title"] = "Productos"; }
<div class="page-heading d-flex justify-content-between align-items-center mb-4"><div><h1>Productos</h1><p class="text-muted mb-0">Administra la carta y sus categorías.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo producto</a></div>
<div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Producto</th><th>Descripción</th><th>Precio</th><th>Estado</th><th>Categoría</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td class="fw-semibold">@item.NombreProducto</td><td>@(string.IsNullOrWhiteSpace(item.Descripcion) ? "Sin descripción" : item.Descripcion)</td><td>S/ @item.Precio.ToString("N2")</td><td><span class="status-badge @(item.Estado ? "status-active" : "status-inactive")">@(item.Estado ? "Activo" : "Inactivo")</span></td><td>@(item.Categoria?.NombreCategoria ?? "Sin categoría")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Details" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-secondary">Ver</a> <a asp-action="Delete" asp-route-id="@item.IdProducto" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center py-5 text-muted">Aún no hay productos registrados.</td></tr> }</tbody></table></div></div>
