@model PolleriaLovely.Models.Producto
@{ ViewData["Title"] = "Detalle del producto"; }
<div class="form-card"><h1>Detalle del producto</h1><dl class="row mb-4"><dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.NombreProducto</dd><dt class="col-sm-4">Descripción</dt><dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción" : Model.Descripcion)</dd><dt class="col-sm-4">Precio</dt><dd class="col-sm-8">S/ @Model.Precio.ToString("N2")</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Estado ? "Activo" : "Inactivo")</dd><dt class="col-sm-4">Categoría</dt><dd class="col-sm-8">@(Model.Categoria?.NombreCategoria ?? "Sin categoría")</dd></dl><a asp-action="Index" class="btn btn-light">Volver</a> <a asp-action="Edit" asp-route-id="@Model.IdProducto" class="btn btn-primary">Editar</a></div>
