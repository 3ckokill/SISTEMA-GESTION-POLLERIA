@model PolleriaLovely.ViewModels.VentaRegistroViewModel
@{ ViewData["Title"] = "Nueva venta"; }
<div class="form-card">
    <h1>Nueva venta</h1>
    <p class="text-muted">Agrega los productos vendidos. Los precios y los subtotales se calculan en el servidor con los valores del catálogo.</p>
    @if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        @{ var productos = ViewBag.Productos as IEnumerable<PolleriaLovely.Models.Producto>; }
        <div class="table-responsive mb-2">
            <table class="table align-middle mb-0">
                <thead><tr><th style="width:40%">Producto</th><th style="width:14%">Cantidad</th><th style="width:16%">Precio unitario (S/)</th><th style="width:18%">Subtotal (S/)</th><th style="width:12%"></th></tr></thead>
                <tbody id="lineas">
                @for (var i = 0; i < Model.Detalles.Count; i++)
                {
                    var linea = Model.Detalles[i];
                    <tr class="linea">
                        <td>
                            <select name="Detalles[@i].IdProducto" class="form-select select-producto">
                                <option value="0" data-precio="0">Seleccione un producto</option>
                                @if (productos != null)
                                {
                                    foreach (var p in productos)
                                    {
                                        <option value="@p.IdProducto" data-precio="@p.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@(linea.IdProducto == p.IdProducto ? "selected" : null)">@p.NombreProducto — S/ @p.Precio.ToString("N2")</option>
                                    }
                                }
                            </select>
                        </td>
                        <td><input name="Detalles[@i].Cantidad" class="form-control cant" type="number" min="1" max="999" value="@linea.Cantidad" /></td>
                        <td><input class="form-control precio" type="text" readonly value="" /></td>
                        <td><input class="form-control subtotal" type="text" readonly value="" /></td>
                        <td class="text-end"><button type="button" class="btn btn-outline-danger btn-sm quitar" title="Quitar línea">✕</button></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (productos == null || !productos.Any())
        {
            <div class="alert alert-warning">No hay productos disponibles para vender.</div>
        }
        <button type="button" id="agregar" class="btn btn-outline-primary btn-sm mb-3">+ Agregar producto</button>
        <div class="d-flex justify-content-end mb-3"><strong class="fs-5">Total: <span id="total">S/ 0.00</span></strong></div>
        <a asp-controller="Cajero" asp-action="Index" class="btn btn-light">Cancelar</a>
        <button type="submit" class="btn btn-primary">Registrar venta</button>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            function renumerar() {
                $('#lineas tr.linea').each(function (i) {
                    $(this).find('.select-producto').attr('name', 'Detalles[' + i + '].IdProducto');
                    $(this).find('.cant').attr('name', 'Detalles[' + i + '].Cantidad');
                });
            }
            function recalcular() {
                var total = 0;
                $('#lineas tr.linea').each(function () {
                    var precio = parseFloat($(this).find('.select-producto option:selected').attr('data-precio')) || 0;
                    var cant = parseInt($(this).find('.cant').val(), 10) || 0;
                    var sub = precio * cant;
                    $(this).find('.precio').val(precio.toFixed(2));
                    $(this).find('.subtotal').val(sub.toFixed(2));
                    total += sub;
                });
                $('#total').text('S/ ' + total.toFixed(2));
            }
            $(document).on('change', '.select-producto', recalcular);
            $(document).on('input', '.cant', recalcular);
            $(document).on('click', '.quitar', function () {
                if ($('#lineas tr.linea').length <= 1) return;
                $(this).closest('tr').remove();
                renumerar();
                recalcular();
            });
            $('#agregar').on('click', function () {
                var fila = $('#lineas tr.linea').first().clone();
                fila.find('.select-producto').val('0');
                fila.find('.cant').val(1);
                fila.find('.precio, .subtotal').val('');
                $('#lineas').append(fila);
                renumerar();
                recalcular();
            });
            $('form').on('submit', function () {
                var pendiente = false;
                $('#lineas tr.linea .select-producto').each(function () {
                    if (!$(this).val() || $(this).val() === '0') pendiente = true;
                });
                if (pendiente) {
                    alert('Debe seleccionar un producto en todas las líneas.');
                    return false;
                }
                return true;
            });
            recalcular();
        })();
    </script>
}
