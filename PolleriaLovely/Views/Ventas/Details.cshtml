@model PolleriaLovely.Models.Venta
@{ ViewData["Title"] = "Detalle de la venta"; }
<div class="page-heading mb-4"><h1>Venta #@Model.IdVenta</h1><p class="text-muted mb-0">Detalle de la venta registrada.</p></div>
<div class="form-card mb-4">
    <div class="row g-3">
        <div class="col-sm-4"><div class="text-muted small">Fecha</div><div class="fw-semibold">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</div></div>
        <div class="col-sm-4"><div class="text-muted small">Registrada por</div><div class="fw-semibold">@(Model.Usuario?.NombreUsuario ?? "—")</div></div>
        <div class="col-sm-4"><div class="text-muted small">Total</div><div class="fw-semibold fs-5">S/ @Model.Total.ToString("N2")</div></div>
    </div>
</div>
<div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Precio unitario</th><th class="text-end">Subtotal</th></tr></thead><tbody>
@foreach (var linea in Model.DetalleVentas) { <tr><td class="fw-semibold">@(linea.Producto?.NombreProducto ?? $"Producto #{linea.IdProducto}")</td><td class="text-end">@linea.Cantidad</td><td class="text-end">S/ @linea.PrecioUnitario.ToString("N2")</td><td class="text-end">S/ @linea.Subtotal.ToString("N2")</td></tr> }
</tbody></table></div></div>
<div class="mt-4"><a asp-action="Index" class="btn btn-light">Volver al historial</a></div>
