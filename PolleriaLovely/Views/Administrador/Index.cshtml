@{
    ViewData["Title"] = "Panel de Administrador";

    var modulos = new[]
    {
        (Nombre: "Productos",   Controlador: "Productos",   Icono: "▣",  Color: "icon-red",  Texto: "Crear, editar y consultar los productos de la pollería."),
        (Nombre: "Categorías",  Controlador: "Categorias",  Icono: "◇",  Color: "icon-gold", Texto: "Gestionar las categorías de los productos."),
        (Nombre: "Insumos",     Controlador: "Insumos",     Icono: "▤",  Color: "icon-navy", Texto: "Administrar insumos y su stock mínimo."),
        (Nombre: "Proveedores", Controlador: "Proveedores", Icono: "⌂",  Color: "icon-red",  Texto: "Gestionar proveedores y sus datos de contacto."),
        (Nombre: "Ventas",      Controlador: "Ventas",      Icono: "S/", Color: "icon-gold", Texto: "Consultar el historial de ventas y su detalle."),
        (Nombre: "Pedidos",     Controlador: "Pedidos",     Icono: "≡",  Color: "icon-navy", Texto: "Consultar comandas y actualizar su estado de preparación."),
        (Nombre: "Mesas",       Controlador: "Mesas",       Icono: "♙",  Color: "icon-red",  Texto: "Crear, editar y activar las mesas disponibles para atención."),
        (Nombre: "Gastos",      Controlador: "Gastos",      Icono: "$",  Color: "icon-gold", Texto: "Registrar gastos y consultar la utilidad estimada del negocio."),
        (Nombre: "Usuarios",    Controlador: "Usuarios",    Icono: "♙",  Color: "icon-red",  Texto: "Gestionar usuarios, roles y accesos al sistema."),
        (Nombre: "Reportes",    Controlador: "Reportes",    Icono: "▥",  Color: "icon-gold", Texto: "Consultar ventas y pedidos por rango de fechas."),
        (Nombre: "Caja",        Controlador: "Caja",        Icono: "▤",  Color: "icon-navy", Texto: "Consultar aperturas, cierres y diferencias de caja.")
    };
}

<div class="admin-dashboard py-2">
    <section class="admin-hero">
        <div>
            <p class="dashboard-eyebrow">CENTRO DE CONTROL</p>
            <h1>Panel de Administrador</h1>
            <p>Bienvenido al sistema de gestión de Pollería Lovely. Selecciona un módulo para continuar.</p>
        </div>
        <div class="admin-hero-mark" aria-hidden="true">LC</div>
    </section>

    <div class="dashboard-section-heading">
        <div>
            <p class="dashboard-eyebrow">OPERACIÓN DIARIA</p>
            <h2>Módulos del sistema</h2>
        </div>
        <span>@modulos.Length accesos disponibles</span>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
        @foreach (var m in modulos)
        {
            <div class="col">
                <div class="dashboard-card h-100">
                    <div class="card-body">
                        <span class="dashboard-card-icon @m.Color">@m.Icono</span>
                        <h5 class="card-title">@m.Nombre</h5>
                        <p class="card-text">@m.Texto</p>
                        <a class="btn btn-primary" asp-area="" asp-controller="@m.Controlador" asp-action="Index">Ir a @m.Nombre</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>