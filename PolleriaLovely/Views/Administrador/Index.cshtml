@{
    ViewData["Title"] = "Panel de Administrador";
}

<div class="container py-3">
    <h1>Panel de Administrador</h1>

    <p>Bienvenido al sistema de gestión de Pollería Lovely. Selecciona un módulo:</p>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Productos</h5>
                    <p class="card-text">Crear, editar y consultar los productos de la pollería.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Productos" asp-action="Index">Ir a Productos</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Categorías</h5>
                    <p class="card-text">Gestionar las categorías de los productos.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Categorias" asp-action="Index">Ir a Categorías</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Insumos</h5>
                    <p class="card-text">Administrar insumos y su stock mínimo.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Insumos" asp-action="Index">Ir a Insumos</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Proveedores</h5>
                    <p class="card-text">Gestionar proveedores y sus datos de contacto.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Proveedores" asp-action="Index">Ir a Proveedores</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Ventas</h5>
                    <p class="card-text">Consultar el historial de ventas y su detalle.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Ventas" asp-action="Index">Ir a Ventas</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Pedidos</h5>
                    <p class="card-text">Consultar comandas y actualizar su estado de preparación.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Pedidos" asp-action="Index">Ir a Pedidos</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Usuarios</h5>
                    <p class="card-text">Gestionar usuarios, roles y accesos al sistema.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Usuarios" asp-action="Index">Ir a Usuarios</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Reportes</h5>
                    <p class="card-text">Consultar ventas y pedidos por rango de fechas.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Reportes" asp-action="Index">Ir a Reportes</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Caja</h5>
                    <p class="card-text">Consultar aperturas, cierres y diferencias de caja.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Caja" asp-action="Index">Ir a Caja</a>
                </div>
            </div>
        </div>
    </div>
</div>
