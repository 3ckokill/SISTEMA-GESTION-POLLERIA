@{
    ViewData["Title"] = "Panel de Administrador";
}

<div class="container py-3">
    <h1>Panel de Administrador</h1>

    <p>Bienvenido al sistema de gestión de Pollería Lovely. Selecciona un módulo:</p>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Productos</h5>
                    <p class="card-text">Crear, editar y consultar los productos de la pollería.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Productos" asp-action="Index">Ir a Productos</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Categorías</h5>
                    <p class="card-text">Gestionar las categorías de los productos.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Categorias" asp-action="Index">Ir a Categorías</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Insumos</h5>
                    <p class="card-text">Administrar insumos y su stock mínimo.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Insumos" asp-action="Index">Ir a Insumos</a>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Proveedores</h5>
                    <p class="card-text">Gestionar proveedores y sus datos de contacto.</p>
                    <a class="btn btn-primary" asp-area="" asp-controller="Proveedores" asp-action="Index">Ir a Proveedores</a>
                </div>
            </div>
        </div>
    </div>
</div>
