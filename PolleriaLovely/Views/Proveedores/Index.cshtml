@model IEnumerable<PolleriaLovely.Proveedor>
@{ ViewData["Title"] = "Proveedores"; }
<div class="page-heading d-flex justify-content-between align-items-center mb-4"><div><h1>Proveedores</h1><p class="text-muted mb-0">Administra los proveedores del negocio.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo proveedor</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Proveedor</th><th>RUC</th><th>Teléfono</th><th>Dirección</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td class="fw-semibold">@item.NombreProveedor</td><td>@item.RucProveedor</td><td>@item.Telefono</td><td>@item.Direccion</td><td><span class="status-badge @(item.Estado ? "status-active" : "status-inactive")">@(item.Estado ? "Activo" : "Inactivo")</span></td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Details" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-outline-secondary">Ver</a> <a asp-action="Delete" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="6" class="text-center py-5 text-muted">Aún no hay proveedores registrados.</td></tr> }</tbody></table></div></div>
