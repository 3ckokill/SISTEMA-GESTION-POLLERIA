@model PolleriaLovely.Proveedor
@{ ViewData["Title"] = "Detalle del proveedor"; }
<div class="form-card"><h1>Detalle del proveedor</h1><dl class="row mb-4"><dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.NombreProveedor</dd><dt class="col-sm-4">RUC</dt><dd class="col-sm-8">@Model.RucProveedor</dd><dt class="col-sm-4">Teléfono</dt><dd class="col-sm-8">@Model.Telefono</dd><dt class="col-sm-4">Dirección</dt><dd class="col-sm-8">@Model.Direccion</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Estado ? "Activo" : "Inactivo")</dd></dl><a asp-action="Index" class="btn btn-light">Volver</a> <a asp-action="Edit" asp-route-id="@Model.IdProveedor" class="btn btn-primary">Editar</a></div>
