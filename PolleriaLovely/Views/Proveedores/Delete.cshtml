@model PolleriaLovely.Proveedor
@{ ViewData["Title"] = "Eliminar proveedor"; }
<div class="form-card"><h1>Eliminar proveedor</h1><div class="alert alert-warning">¿Estás seguro de que deseas eliminar este proveedor?</div><p><strong>@Model.NombreProveedor</strong> — RUC: @Model.RucProveedor</p><p>Teléfono: @Model.Telefono</p><p>Dirección: @Model.Direccion</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="IdProveedor" /><button type="submit" class="btn btn-danger">Sí, eliminar</button> <a asp-action="Index" class="btn btn-light">Cancelar</a></form></div>
