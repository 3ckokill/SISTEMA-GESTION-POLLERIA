@model PolleriaLovely.Models.Insumo
@{ ViewData["Title"] = "Detalle del insumo"; }
<div class="form-card"><h1>Detalle del insumo</h1><dl class="row mb-4"><dt class="col-sm-4">Nombre</dt><dd class="col-sm-8">@Model.NombreInsumo</dd><dt class="col-sm-4">Unidad de medida</dt><dd class="col-sm-8">@Model.UnidadMedida</dd><dt class="col-sm-4">Stock</dt><dd class="col-sm-8">@Model.Stock.ToString("N2")</dd><dt class="col-sm-4">Stock mínimo</dt><dd class="col-sm-8">@Model.StockMinimo.ToString("N2")</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Estado ? "Activo" : "Inactivo")</dd><dt class="col-sm-4">Proveedor</dt><dd class="col-sm-8">@(Model.Proveedor?.NombreProveedor ?? "Sin proveedor")</dd></dl><a asp-action="Index" class="btn btn-light">Volver</a> <a asp-action="Edit" asp-route-id="@Model.IdInsumo" class="btn btn-primary">Editar</a></div>
