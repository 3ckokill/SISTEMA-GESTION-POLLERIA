@model IEnumerable<PolleriaLovely.Models.Insumo>
@{ ViewData["Title"] = "Insumos"; }
<div class="page-heading d-flex justify-content-between align-items-center mb-4"><div><h1>Insumos</h1><p class="text-muted mb-0">Administra el inventario y sus proveedores.</p></div><a asp-action="Create" class="btn btn-primary">Nuevo insumo</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-warning">@error</div> }
<div class="table-card"><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Insumo</th><th>Unidad</th><th>Stock</th><th>Stock mínimo</th><th>Estado</th><th>Proveedor</th><th class="text-end">Acciones</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td class="fw-semibold">@item.NombreInsumo</td><td>@item.UnidadMedida</td><td>@item.Stock.ToString("N2")</td><td>@item.StockMinimo.ToString("N2")</td><td><span class="status-badge @(item.Estado ? "status-active" : "status-inactive")">@(item.Estado ? "Activo" : "Inactivo")</span></td><td>@(item.Proveedor?.NombreProveedor ?? "Sin proveedor")</td><td class="text-end"><a asp-action="Edit" asp-route-id="@item.IdInsumo" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Details" asp-route-id="@item.IdInsumo" class="btn btn-sm btn-outline-secondary">Ver</a> <a asp-action="Delete" asp-route-id="@item.IdInsumo" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr> }
@if (!Model.Any()) { <tr><td colspan="7" class="text-center py-5 text-muted">Aún no hay insumos registrados.</td></tr> }</tbody></table></div></div>
