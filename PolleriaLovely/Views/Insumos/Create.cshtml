@model PolleriaLovely.Models.Insumo
@{ ViewData["Title"] = "Nuevo insumo"; }
<div class="form-card">
    <h1>Nuevo insumo</h1>
    <p class="text-muted">Registra la información del insumo y su proveedor.</p>
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label asp-for="NombreInsumo" class="form-label">Nombre del insumo</label>
            <input asp-for="NombreInsumo" class="form-control" placeholder="Ej. Pollo entero congelado" />
            <span asp-validation-for="NombreInsumo" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="UnidadMedida" class="form-label">Unidad de medida</label>
            <select asp-for="UnidadMedida" asp-items="ViewBag.UnidadMedida" class="form-select" data-val-required="La unidad de medida es obligatoria.">
                <option value="">Selecciona una unidad</option>
            </select>
            <span asp-validation-for="UnidadMedida" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Stock" class="form-label">Stock</label>
            <input asp-for="Stock" class="form-control" type="text" inputmode="decimal" data-val-number="Ingrese un stock válido." placeholder="0.00" />
            <span asp-validation-for="Stock" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="StockMinimo" class="form-label">Stock mínimo</label>
            <input asp-for="StockMinimo" class="form-control" type="text" inputmode="decimal" data-val-number="Ingrese un stock mínimo válido." placeholder="0.00" />
            <span asp-validation-for="StockMinimo" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="IdProveedor" class="form-label">Proveedor</label>
            <select asp-for="IdProveedor" asp-items="ViewBag.IdProveedor" class="form-select" data-val-required="Debe seleccionar un proveedor." data-val-range="Debe seleccionar un proveedor válido.">
                <option value="">Selecciona un proveedor</option>
            </select>
            <span asp-validation-for="IdProveedor" class="text-danger"></span>
        </div>
        <div class="form-check form-switch mb-4">
            <input asp-for="Estado" class="form-check-input" />
            <label asp-for="Estado" class="form-check-label">Insumo activo</label>
        </div>
        <a asp-action="Index" class="btn btn-light">Cancelar</a>
        <button type="submit" class="btn btn-primary">Guardar insumo</button>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
