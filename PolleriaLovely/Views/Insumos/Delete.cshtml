@model PolleriaLovely.Models.Insumo
@{ ViewData["Title"] = "Eliminar insumo"; }
<div class="form-card"><h1>Eliminar insumo</h1><div class="alert alert-warning">¿Estás seguro de que deseas eliminar este insumo?</div><p><strong>@Model.NombreInsumo</strong> — @Model.Stock.ToString("N2") @Model.UnidadMedida</p><p>Proveedor: @(Model.Proveedor?.NombreProveedor ?? "Sin proveedor")</p><form asp-action="Delete" method="post"><input type="hidden" asp-for="IdInsumo" /><button type="submit" class="btn btn-danger">Sí, eliminar</button> <a asp-action="Index" class="btn btn-light">Cancelar</a></form></div>
