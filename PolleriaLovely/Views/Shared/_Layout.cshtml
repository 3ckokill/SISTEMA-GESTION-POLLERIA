@{
    var ctl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esAdmin = User.IsInRole("Administrador");
    var esCajero = User.IsInRole("Cajero");
    var esMozo = User.IsInRole("Mozo");
    var conMenu = esAdmin || esCajero || esMozo;
    var rol = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
    var inicioCtl = esAdmin ? "Administrador" : esCajero ? "Cajero" : esMozo ? "Mozo" : "Home";

    bool En(string c) => string.Equals(c, ctl, StringComparison.OrdinalIgnoreCase);
    string Cls(bool activo) => activo ? " active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lovely Chicken</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PolleriaLovely.styles.css" asp-append-version="true" />
</head>
<body class="@(esAdmin ? "admin-layout" : esCajero ? "cajero-layout" : esMozo ? "mozo-layout" : "")@(ViewData["PaginaLogin"] is true ? " login-layout" : "")">
    <header class="app-topbar">
        <div class="app-topbar-inner">
            @if (conMenu)
            {
                <button class="btn btn-outline-primary btn-sm d-lg-none" type="button"
                        data-bs-toggle="collapse" data-bs-target="#menuLateral"
                        aria-controls="menuLateral" aria-expanded="false" aria-label="Abrir menú">
                    Menú
                </button>
            }

            <a class="app-brand" asp-area="" asp-controller="@inicioCtl" asp-action="Index">Lovely Chicken</a>

            <div class="app-user">
                @if (autenticado)
                {
                    <span>@User.Identity!.Name (@rol)</span>
                    @if (!conMenu)
                    {
                        <form asp-controller="Usuario" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Cerrar sesión</button>
                        </form>
                    }
                }
                else
                {
                    <a class="btn btn-outline-primary btn-sm" asp-area="" asp-controller="Usuario" asp-action="Login">Iniciar sesión</a>
                }
            </div>
        </div>
    </header>

    @if (conMenu)
    {
        <div class="app-body">
            <aside id="menuLateral" class="sidebar collapse d-lg-block" aria-label="@(esAdmin ? "Menú del administrador" : esCajero ? "Menú del cajero" : "Menú del mozo")">
                <div class="sidebar-inner">
                    <nav class="sidebar-nav">
                        @if (esAdmin)
                        {
                            <a class="@Cls(En("Productos"))" asp-controller="Productos" asp-action="Index">Productos</a>
                            <a class="@Cls(En("Categorias"))" asp-controller="Categorias" asp-action="Index">Categorías</a>
                            <a class="@Cls(En("Insumos"))" asp-controller="Insumos" asp-action="Index">Insumos</a>
                            <a class="@Cls(En("Proveedores"))" asp-controller="Proveedores" asp-action="Index">Proveedores</a>
                            <a class="@Cls(En("Ventas"))" asp-controller="Ventas" asp-action="Index">Ventas</a>
                            <a class="@Cls(En("Pedidos"))" asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                            <a class="@Cls(En("Mesas"))" asp-controller="Mesas" asp-action="Index">Mesas</a>
                            <a class="@Cls(En("Caja"))" asp-controller="Caja" asp-action="Index">Caja</a>
                            <a class="@Cls(En("Gastos"))" asp-controller="Gastos" asp-action="Index">Gastos</a>
                            <a class="@Cls(En("Usuarios"))" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                            <a class="@Cls(En("Reportes"))" asp-controller="Reportes" asp-action="Index">Reportes</a>
                        }
                        else if (esCajero)
                        {
                            <a class="@Cls(En("Ventas"))" asp-controller="Ventas" asp-action="Create">Nueva venta</a>
                            <a class="@Cls(En("Pedidos"))" asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                            <a class="@Cls(En("Caja"))" asp-controller="Caja" asp-action="Index">Caja</a>
                        }
                        else
                        {
                            <a class="@Cls(En("Pedidos") && accion != "Create")" asp-controller="Pedidos" asp-action="Index">Pedidos</a>
                            <a class="@Cls(En("Pedidos") && accion == "Create")" asp-controller="Pedidos" asp-action="Create">Nuevo pedido</a>
                        }
                    </nav>
                    <form asp-controller="Usuario" asp-action="Logout" method="post" class="sidebar-foot">
                        <button type="submit" class="btn btn-logout">Cerrar sesión</button>
                    </form>
                </div>
            </aside>
            <div class="app-content">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Lovely Chicken - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>