@{
    ViewData["Title"] = "Panel del Mozo";
}

<div class="role-dashboard py-2">
    <section class="role-hero">
        <div>
            <p class="dashboard-eyebrow">ATENCIÓN EN SALÓN</p>
            <h1>Panel del Mozo</h1>
            <p>Registra pedidos y acompaña cada mesa durante el servicio.</p>
        </div>
        <div class="role-hero-mark role-hero-mark-red" aria-hidden="true">M</div>
    </section>

    <div class="role-actions">
        <div class="role-action-card">
            <span class="dashboard-card-icon icon-red">≡</span>
            <h2>Nuevo pedido</h2>
            <p>Registra los productos solicitados por una mesa.</p>
            <a asp-controller="Pedidos" asp-action="Create" class="btn btn-primary">Registrar nuevo pedido</a>
        </div>
        <div class="role-action-card role-action-card-muted">
            <span class="dashboard-card-icon icon-navy">▤</span>
            <h2>Pedidos en curso</h2>
            <p>Consulta estados, agrega productos y solicita la cuenta.</p>
            <a asp-controller="Pedidos" asp-action="Index" class="btn btn-outline-primary">Ver pedidos</a>
        </div>
    </div>
</div>